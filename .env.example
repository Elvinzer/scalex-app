# Supabase — project settings > API / Database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, full-access key (lib/supabase/admin.ts) — used exclusively by
# deleteAccount (app/(app)/settings/actions.ts) to remove the Supabase Auth
# user itself via auth.admin.deleteUser. Never exposed to the client, never logged.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres — Supabase project settings > Database > Connection string
# DATABASE_URL: Transaction pooler (Supavisor, port 6543) — used at runtime by the app.
# DIRECT_URL: Session pooler (port 5432, same pooler host as above) — used by
# drizzle-kit for migrations. Not the literal "direct connection" host: on
# projects without the IPv4 add-on, that host is IPv6-only and won't resolve
# from most local/CI networks, so the Session pooler is used instead.
DATABASE_URL=
DIRECT_URL=

# Master key used to encrypt the user's own Anthropic API key and Stripe
# access token before they are stored in the database (AES-256-GCM).
# Never the same value across environments, never committed.
ENCRYPTION_KEY=

# Stripe Connect (OAuth standard accounts) — from the Stripe Dashboard,
# Connect settings. STRIPE_WEBHOOK_SECRET is reserved for a Stripe webhook
# receiver that isn't built yet — no route currently calls
# stripe.webhooks.constructEvent with it. Once that webhook exists, per the
# project's non-negotiable rules it MUST verify the signature with this
# secret before acting on any event.
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_CLIENT_SECRET=
STRIPE_WEBHOOK_SECRET=

# Instagram Graph API ("Instagram API with Instagram Login") — from a
# Business-type Meta App at developer.facebook.com with the Instagram
# product added (no Facebook Page required with this login method).
# IMPORTANT: these are NOT the App ID/App Secret shown at the top of the
# dashboard (App settings > Basic) — Meta generates a SEPARATE Instagram App
# ID / Instagram App Secret once you add the Instagram product, found under
# Instagram > API setup with Instagram login > Business login settings.
# Using the top-level Meta App ID here fails with "Invalid platform app".
# Until Meta App Review approves instagram_business_manage_insights
# (Advanced Access), only accounts added as Testers/Admins on THIS app can
# connect — see lib/instagram/protocol.ts.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Meta Marketing API (Facebook Login for Business) — top-level Meta App
# credentials from App settings > Basic. If Instagram and Meta Ads use the
# same Meta App, META_APP_ID/META_APP_SECRET may be omitted and the server
# reuses the INSTAGRAM_* pair above. Set META_* explicitly when they differ.
# The first grant asks for ads_read; ads_management is requested only for an
# explicitly confirmed write action.
META_APP_ID=
META_APP_SECRET=
# Optional Graph API version override. Keep this aligned with the version
# enabled by the Meta app; defaults to the current application pin.
META_GRAPH_API_VERSION=v25.0
META_MAX_DAILY_BUDGET_CHANGE_PERCENT=50
META_MIN_CASH_ATTRIBUTION_COVERAGE_PERCENT=50

# Meta Ads insight rules — defaults are intentionally conservative; tune per
# account only after enough historical volume has been synchronized.
META_INSIGHT_MIN_IMPRESSIONS=1000
META_INSIGHT_MIN_CLICKS=50
META_INSIGHT_MIN_PROFILE_VISITS=50
META_INSIGHT_MIN_COVERAGE_PERCENT=80
META_INSIGHT_VSL_HOLD_RATE_PERCENT=20
META_INSIGHT_VSL_LANDING_TO_LEAD_RATE_PERCENT=10
META_INSIGHT_VSL_CPL_STABILITY_PERCENT=20
META_INSIGHT_VSL_CASH_PER_LEAD_DECLINE_PERCENT=20
META_INSIGHT_WEBINAR_COST_PER_REGISTRATION_STABILITY_PERCENT=20
META_INSIGHT_WEBINAR_SHOWUP_DECLINE_PERCENT=10
META_INSIGHT_WEBINAR_COST_PER_PARTICIPANT_INCREASE_PERCENT=20
META_INSIGHT_WEBINAR_POST_QUALITY_STABILITY_PERCENT=20
META_INSIGHT_WEBINAR_MIN_REGISTRATIONS=20
META_INSIGHT_WEBINAR_MIN_PARTICIPANTS=10
META_INSIGHT_IG_FOLLOW_RATE_PERCENT=10
META_INSIGHT_IG_COST_PER_VISIT_IMPROVEMENT_PERCENT=10
META_INSIGHT_IG_FOLLOWS_GROWTH_PERCENT=10
META_INSIGHT_IG_ENGAGEMENT_DECLINE_PERCENT=10
META_INSIGHT_RETARGETING_FREQUENCY_INCREASE_PERCENT=10
META_INSIGHT_RETARGETING_CTR_DECLINE_PERCENT=10
META_INSIGHT_RETARGETING_CPA_INCREASE_PERCENT=10
META_INSIGHT_RETARGETING_FREQUENCY_SATURATION=3
META_INSIGHT_RETARGETING_WINDOW_CPA_RATIO=1.5
META_INSIGHT_RETARGETING_MIN_WINDOW_LEADS=5

# YouTube (Data API v3 + Analytics API) — from a Google Cloud project at
# console.cloud.google.com, "OAuth 2.0 Client ID" of type "Web application"
# (APIs & Services > Credentials). Enable "YouTube Data API v3" and "YouTube
# Analytics API" on the project first. Authorized redirect URI must be
# exactly {origin}/api/youtube/callback.
# IMPORTANT: youtube.readonly and yt-analytics.readonly are Google
# "sensitive" scopes — the OAuth consent screen needs Google's verification
# (multi-day review + an unlisted demo video) before arbitrary external
# Google accounts can connect. Until that review completes, only accounts
# added as Test Users in the same Cloud project (OAuth consent screen >
# Audience > Test users, cap: 100) can complete the flow — same situation as
# Instagram's pending Meta App Review above, see lib/youtube/protocol.ts.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Native booking calendar OAuth — separate credentials from the YouTube Google
# connection. Redirect URIs are {origin}/api/native-calendar/{provider}/callback.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Development-only in-memory calendar provider used by reproducible browser
# fixtures. Must never be enabled in production.
NATIVE_BOOKING_CALENDAR_TEST_MODE=0

# Inngest — INNGEST_DEV=1 tells the SDK to talk to the local Inngest Dev
# Server (`npx inngest-cli@latest dev`) instead of Inngest Cloud. Only
# INNGEST_EVENT_KEY / INNGEST_SIGNING_KEY are required in deployed environments.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Fallback used by lib/agent/client.ts only when a user hasn't configured
# their own BYOK Anthropic key yet. Usage is quota-tracked per user
# (lib/agent/quota.ts) — never the same value as a user's own key, never logged.
ANTHROPIC_SHARED_API_KEY=

# Shared key for the "Améliorer" chat on /diagnostic ONLY (lib/ai-provider.ts,
# app/api/improve-chat/route.ts) — a deliberate, scoped exception to the BYOK
# rule above: this is one shared server-side key for every user, not per-user.
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=

# PostHog — product analytics (lib/analytics.ts server-side, lib/analytics-client.ts
# browser-side). Entirely optional: unset, tracking calls no-op and the
# /admin HogQL blocks render "—" instead of erroring. NEXT_PUBLIC_POSTHOG_KEY/HOST
# are exposed to the client on purpose (PostHog's project key is not a secret).
# POSTHOG_PERSONAL_API_KEY is a DIFFERENT key (Project Settings > API Keys >
# Personal API Keys, not the project key) used only server-side by
# lib/posthog-query.ts for the /admin HogQL queries — never exposed to the client.
# POSTHOG_PROJECT_ID is that project's numeric ID (Project Settings > Project ID).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Resend — Monday weekly-brief email (lib/inngest/functions/weekly-brief-email.ts).
RESEND_API_KEY=
# Optional sender override for native booking notifications.
RESEND_FROM_EMAIL=

# Absolute origin used to build links inside the Monday email (an Inngest
# scheduled function has no incoming request to read an origin from).
# e.g. https://app.scalex.example — no trailing slash.
APP_URL=

# Same origin, exposed to the client — shown as plain text on the exported
# metric health cards (Dashboard carousel), e.g. "scalex.example".
NEXT_PUBLIC_APP_URL=

# Signs the unsubscribe link token (app/api/unsubscribe/route.ts) so a user
# can't unsubscribe someone else by guessing their user id. Any long random
# string, never the same value as ENCRYPTION_KEY.
UNSUBSCRIBE_TOKEN_SECRET=

# /admin dashboard — comma-separated list of emails allowed in (app/admin/layout.tsx).
ADMIN_EMAILS=
